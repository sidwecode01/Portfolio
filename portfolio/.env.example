# ---------------------------------------------------------------------------
# Variables CLIENT (exposees au navigateur — prefixe VITE_ obligatoire)
# Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...votre_cle_anon...

# ---------------------------------------------------------------------------
# Variables SERVEUR (fonction Vercel /api/track UNIQUEMENT)
# NE JAMAIS prefixer par VITE_ (sinon la cle secrete serait exposee au client).
# A definir dans Vercel : Project Settings > Environment Variables.
# La cle service_role est dans Supabase > Project Settings > API > service_role.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...votre_cle_service_role...
